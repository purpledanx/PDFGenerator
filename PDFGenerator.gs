function isDailyTab_(s) { return /^\d{1,2}-\d{1,2}$/.test(s); }
function pad2_(n) { return String(n).padStart(2, '0'); }
function norm_(s) {
  return String(s || '').trim().toLowerCase()
    .replace(/\s*\/\s*/g, '/').replace(/\s+/g, ' ')
    .replace(/^level\b/, 'lvl').replace(/^activitiy\b/, 'activity');
}
function getSessionDate_(sheet) {
  const m = sheet.getName().match(/^(\d{1,2})-(\d{1,2})$/);
  const y = sheet.getParent().getName().match(/\b\d{1,2}-(\d{4})\b/);
  if (!m || !y) throw new Error('Use a date tab like 10-07, in a journal named Journal 10-2026.');
  const month = Number(m[1]), day = Number(m[2]), year = Number(y[1]);
  const check = new Date(Date.UTC(year, month-1, day));
  if (check.getUTCFullYear() !== year || check.getUTCMonth() !== month-1 || check.getUTCDate() !== day) {
    throw new Error('Invalid session date: '+sheet.getName());
  }
  return {iso: `${year}-${pad2_(month)}-${pad2_(day)}`,
    short: `${pad2_(month)}/${pad2_(day)}/${String(year).slice(-2)}`};
}
// Completion date entered manually for a selected CS1 project.
function formatCompletionDate_(iso) {
  const m=String(iso||'').match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if(!m) throw new Error('CS1 completion date must be YYYY-MM-DD.');
  const y=Number(m[1]),mo=Number(m[2]),d=Number(m[3]);
  const test=new Date(Date.UTC(y,mo-1,d));
  if(test.getUTCFullYear()!==y || test.getUTCMonth()!==mo-1 || test.getUTCDate()!==d) {
    throw new Error('Invalid CS1 completion date.');
  }
  return pad2_(mo)+'/'+pad2_(d)+'/'+String(y).slice(-2);
}
function escapeHtml_(v) {
  return String(v).replace(/[&<>"']/g, a=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[a]));
}

// Unity has no automatic "Working on ...!" note.
function defaultProjectNote_(project, course) {
  return /^unity_/i.test(String(course || ''))
    ? '' : 'Working on ' + String(project || '').trim() + '!';
}
function getSuggestedNote_(sheet, row, project, course) {
  return defaultProjectNote_(project, course);
}

// Only column N is owned by this generator. The journal uses A-M.
// No PDF LINK, PDF UPDATED, PDF SENSEI, PDF NOTES, or PDF SIGNATURE columns.
const PDF_STATUS_COLUMN_ = 14;
function ensurePdfStatusColumn_(sheet) {
  const header = sheet.getRange(1, PDF_STATUS_COLUMN_).getDisplayValue().trim();
  if (header === 'PDF STATUS') return;
  if (header) throw new Error(
    'Column N currently has header "' + header + '". Back up/move any old PDF data in N and clear that column before using this version. A-M will not be touched.');
  const n = sheet.getLastRow() - 2;
  if (n > 0 && sheet.getRange(3, PDF_STATUS_COLUMN_, n, 1)
      .getDisplayValues().some(r => r[0].trim())) {
    throw new Error('Column N already has data. Back it up and clear column N to use it for PDF STATUS.');
  }
  sheet.getRange(1, PDF_STATUS_COLUMN_).setValue('PDF STATUS');
}
// Optional one-time cleanup for metadata created by the older v9 script.
// This runs ONLY when O1:S1 exactly matches its five known headers and
// after the user explicitly confirms. Never touches A-N or unknown columns.
function clearOldPdfMetadata_() {
  const sh=SpreadsheetApp.getActiveSheet();
  if(!isDailyTab_(sh.getName())) throw new Error('Select a dated journal tab first.');
  const expected=['PDF LINK','PDF UPDATED','PDF SENSEI','PDF NOTES','PDF SIGNATURE'];
  const found=sh.getRange(1,15,1,5).getDisplayValues()[0].map(x=>x.trim());
  if(!expected.every((text,i)=>found[i]===text)) {
    SpreadsheetApp.getUi().alert('O-S do not exactly match the old PDF metadata headers; nothing was deleted.');
    return;
  }
  const ui=SpreadsheetApp.getUi();
  if(ui.alert('Clear old PDF metadata?',
      'Delete the old PDF metadata stored in columns O-S on '+sh.getName()+
      '? This cannot be undone through the PDF Undo button. Column N and the journal columns A-M will remain unchanged.',
      ui.ButtonSet.YES_NO)!==ui.Button.YES) return;
  sh.getRange(1,15,Math.max(1,sh.getLastRow()),5).clearContent();
  ui.alert('Old PDF metadata cleared from O-S. Future updates write only column N.');
}

function initializePdfStatuses_(sheet) {
  ensurePdfStatusColumn_(sheet);
  const n = sheet.getLastRow() - 2;
  if (n < 1) return;
  const names = sheet.getRange(3, 1, n, 1).getDisplayValues();
  const statuses = sheet.getRange(3, PDF_STATUS_COLUMN_, n, 1).getDisplayValues();
  for (let i = 0; i < n; i++) {
    if (names[i][0].trim() && !statuses[i][0].trim()) {
      sheet.getRange(i + 3, PDF_STATUS_COLUMN_)
        .setValue('NOT GENERATED').setBackground('#f1f3f4');
    }
  }
}

function openTrackerPopup() {
  const sh=SpreadsheetApp.getActiveSheet();
  if (!isDailyTab_(sh.getName())) throw new Error('Choose a dated journal tab (example: 10-07).');
  initializePdfStatuses_(sh);
  const active=sh.getActiveRange();
  const selectedRow=active ? active.getRow() : 0;
  const selectedName=selectedRow>=3 ? sh.getRange(selectedRow,1).getDisplayValue().trim() : '';
  const selectedValid=Boolean(selectedName);
  const date=getSessionDate_(sh).short;
  const activity=selectedValid ? sh.getRange(selectedRow,5).getDisplayValue().trim() : '';
  const course=selectedValid ? sh.getRange(selectedRow,4).getDisplayValue().trim() : '';
  const isScratchJr=selectedValid && norm_(course)==='jr';
  const isCS1=selectedValid && norm_(course)==='cs_1';
  const cs1Projects=isCS1 ? getCurriculum_(sh.getParent(),course).tasks : [];
  const cs1Options=cs1Projects.map((project,i)=>
    '<option value="'+i+'">'+escapeHtml_(project)+'</option>').join('');
  const dateISO=getSessionDate_(sh).iso;
  const sensei='';
  const notes=selectedValid ? getSuggestedNote_(sh,selectedRow,activity,course) : '';
  const names=sh.getRange(3,1,Math.max(1,sh.getLastRow()-2),1).getDisplayValues();
  const dayRows=names.map((r,i)=>r[0].trim() ? i+3 : 0).filter(Boolean);
  if (!selectedValid && !dayRows.length) throw new Error('No student rows to process on this tab.');
  const safeAction='GENERATE / UPDATE TRACKERS';
  const undoRun=lastTrackerRun_();
  const undoCount=undoRun && undoRun.count ? undoRun.count : 0;
  const undoId=undoCount ? undoRun.id : '';
  const undoTab=undoCount ? undoRun.tab : '';
  const undoPreview=undoCount ? getUndoPreview_(undoRun) : [];
  const undoDetails=undoPreview.map(item=>
    '<li><b>'+escapeHtml_(item.student)+'</b> — '+escapeHtml_(item.fileName)+
    (item.project?' <span class="muted">('+escapeHtml_(item.project)+')</span>':'')+
    '</li>').join('');
  const undoLabel=undoPreview.length===1
    ? 'Undo update for '+undoPreview[0].student :
    'Undo last update for '+undoPreview.length+' student tracker(s)';
  const html=`<!DOCTYPE html><html><head><base target="_top">
  <style>
  body{font:14px Arial;padding:16px;color:#202124}
  h3{margin:0 0 14px;font-size:17px}
  p{line-height:1.5}
  label{display:block;margin:12px 0 6px}
  .radio{display:flex;gap:8px;border:1px solid #dadce0;border-radius:7px;padding:12px;margin:10px 0;cursor:pointer}
  .radio input{width:auto;margin-top:2px}
  .muted{font-size:12px;color:#5f6368}
  .primary{background:#1a73e8;color:white;border:0;border-radius:5px;padding:10px 16px;cursor:pointer}
  .secondary{background:white;border:1px solid #dadce0;border-radius:5px;padding:10px 16px;cursor:pointer}
  button:disabled{opacity:.55;cursor:wait}
  .actions{display:flex;gap:8px;margin-top:18px}
  input[type=text],input[type=date],select,textarea{width:100%;padding:9px;box-sizing:border-box;border:1px solid #dadce0;border-radius:5px;font:inherit}
  textarea{min-height:75px;resize:vertical}
  #results{max-height:170px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;margin-top:12px}
  #summary{margin:10px 0;font-weight:bold}
  .error{color:#b3261e}
  </style></head><body>
  <div id="dayWarning" role="alert" ${selectedValid?'hidden':''}
    style="position:sticky;top:0;z-index:1;padding:12px;margin-bottom:14px;border:2px solid #b3261e;background:#fce8e6;color:#b3261e;border-radius:5px">
    <strong style="font-size:18px">DO NOT CLOSE THIS DIALOG</strong><br>
    Keep it open until the whole-day run finishes. Closing it stops the remaining students.
  </div>
  <div id="choose">
    <h3>Which trackers should I process?</h3>
    <p>Date: <b>${escapeHtml_(date)}</b> • Sheet: <b>${escapeHtml_(sh.getName())}</b></p>
    <label class="radio"><input type="radio" name="scope" value="selected" onchange="showDayWarning()" ${selectedValid?'checked':'disabled'}>
      <span><b>Selected student</b><br><span class="muted">${selectedValid?escapeHtml_(selectedName)+' (row '+selectedRow+')':'Select a student row first to enable'}</span></span></label>
    <label class="radio"><input type="radio" name="scope" value="day" onchange="showDayWarning()" ${selectedValid?'':'checked'}>
      <span><b>Entire day</b><br>
        <strong style="color:#b3261e">DO NOT CLOSE THIS DIALOG</strong><br>
        <span class="muted">${dayRows.length} student row(s) with a name, starting at row 3</span></span></label>
    <div class="actions"><button class="primary" id="continue" onclick="chooseScope()">Continue</button></div>
    <div id="undoArea" ${undoCount?'':'hidden'} style="margin-top:16px;border-top:1px solid #dadce0;padding-top:12px">
      <p class="muted"><b>What Undo will restore</b> — last update on tab <b>${escapeHtml_(undoTab)}</b>. These students' tracker PDFs will return to how they were before the last generation:</p>
      <ul style="margin:6px 0;padding-left:20px;max-height:140px;overflow-y:auto">${undoDetails||'<li>Undo details not available</li>'}</ul>
      <button type="button" class="secondary" id="undoButton" onclick="undoFromPopup()">${escapeHtml_(undoLabel)}</button>
      <div id="undoMessage" role="status" aria-live="polite" style="margin-top:8px;white-space:pre-wrap"></div>
    </div>
  </div>
  <div id="details" hidden>
    <h3 id="detailTitle">Generate tracker</h3>
    <label>Sensei</label><input type="text" id="sensei" value="${escapeHtml_(sensei)}" placeholder="Enter Sensei name">
    <div id="singleFields">
      ${isScratchJr ? `<div id="scratchStars">
        <label>Scratch Jr stars (optional)</label>
        <select id="stars"><option value="0">Leave existing stars unchanged</option><option value="1">1 star</option><option value="2">2 stars</option><option value="3">3 stars</option></select>
        <p class="muted">Stars are recorded only if you select a rating.</p>
      </div>` : ''}
      ${isCS1 ? `<div id="cs1Controls">
        <label for="cs1Complete">CS1 project to mark completed</label>
        <select id="cs1Complete">
          <option value="">None — record current project as Working!</option>
          ${cs1Options}
        </select>
        <p class="muted">Only the selected project gets a completion checkmark. The current journal project stays Work in Progress. Choose a different project from column E.</p>
        <label for="cs1Date">Completion date</label>
        <input id="cs1Date" type="date" value="${dateISO}" required>
        <p class="muted">Sensei above will be written to the selected completed project's By field. Existing completions keep their original date and By value.</p>
      </div>` : ''}
      <label>Notes for the PDF</label>
      <textarea id="notes" maxlength="180" placeholder="Session notes">${escapeHtml_(notes)}</textarea>
    </div>
    <div class="actions"><button class="secondary" id="back" onclick="goBack()">Back</button>
      <button class="primary" id="submit" onclick="submitCards()">${escapeHtml_(safeAction)}</button></div>
    <div id="summary" role="status" aria-live="polite"></div>
    <progress id="dayProgress" value="0" max="${dayRows.length}" style="width:100%" hidden></progress>
    <div id="currentAction" class="muted" role="status" aria-live="polite"></div>
    <div id="results"></div>
    <button class="secondary" id="done" hidden onclick="google.script.host.close()">Close</button>
  </div>
  <script>
  const rows=${JSON.stringify(dayRows)};
  const studentNames=${JSON.stringify(Object.fromEntries(names.map((r,i)=>[i+3,r[0].trim()])))};
  const chosenRow=${selectedRow};
  const selectedName=${JSON.stringify(selectedName)};
  const tab=${JSON.stringify(sh.getName())};
  const updateOriginals=true;
  const isCS1=${isCS1?'true':'false'};
  const isScratchJr=${isScratchJr?'true':'false'};
  const undoId=${JSON.stringify(undoId)};
  const undoCount=${undoCount};
  const undoTab=${JSON.stringify(undoTab)};
  const undoPreview=${JSON.stringify(undoPreview)};
  let scope='selected', completed=0, failed=0, cursor=0, running=false, undoBusy=false;
  let progressTimer=null,activeDayRun=null;
  const el=id=>document.getElementById(id);
  function undoFromPopup(){
    if (running || undoBusy || !undoId || !undoCount) return;
    const names=undoPreview.map(x=>'• '+x.student+' — '+x.fileName).join('\\n');
    const warning='Undo will restore the previous tracker PDFs for:\\n\\n'+names+
      '\\n\\nDate tab: '+undoTab+'\\nExisting journal data will not be changed. '+
      'PDFs modified again since that update will be skipped.';
    if (!window.confirm(warning)) return;
    undoBusy=true;
    el('undoButton').disabled=true;
    el('continue').disabled=true;
    el('undoMessage').textContent='Restoring tracker PDFs...';
    google.script.run.withSuccessHandler(result=>{
      undoBusy=false;
      el('continue').disabled=false;
      el('undoMessage').textContent=result.message;
      if(result.skipped===0 && result.restored>0) {
        google.script.host.close();
      } else {
        el('undoButton').disabled=!result.remaining;
        // Show the result, including any skipped PDFs that need attention.
      }
    }).withFailureHandler(e=>{
      undoBusy=false;
      el('continue').disabled=false;
      el('undoButton').disabled=false;
      el('undoMessage').className='error';
      el('undoMessage').textContent='Undo failed: '+e.message;
    }).undoLastTrackerUpdateFromPopup(undoId);
  }
  function showDayWarning(){
    const choice=document.querySelector('input[name="scope"]:checked');
    el('dayWarning').hidden=!choice || choice.value!=='day';
  }
  function chooseScope(){
    const choice=document.querySelector('input[name="scope"]:checked');
    if(!choice)return;
    scope=choice.value;
    showDayWarning();
    el('choose').hidden=true;el('details').hidden=false;
    el('detailTitle').textContent=scope==='selected'?'Selected student: '+selectedName:
      'DO NOT CLOSE THIS DIALOG — Entire day: '+rows.length+' students';
    el('singleFields').hidden=scope==='day';
    el('summary').textContent='';el('results').textContent='';
    el('dayProgress').hidden=scope!=='day';el('dayProgress').value=0;el('currentAction').textContent='';el('done').hidden=true;
  }
  function goBack(){if(running||undoBusy)return;el('details').hidden=true;el('choose').hidden=false;}
  function addResult(label,url,isError){
    const line=document.createElement('div');
    if(isError)line.className='error';
    line.appendChild(document.createTextNode(label));
    if(url){ const a=document.createElement('a');a.textContent=' Open tracker';a.target='_blank';a.href=url;line.appendChild(a);}
    el('results').appendChild(line);
  }
  function buttonsDisabled(disabled){el('submit').disabled=disabled;el('back').disabled=disabled;}
  function submitCards(){
    if(running||undoBusy)return;
    const s=el('sensei').value.trim();
    const stars=(scope==='selected' && isScratchJr) ? Number(el('stars').value) : 0;
    const cs1Index=(scope==='selected' && isCS1 && el('cs1Complete').value!=='') ? Number(el('cs1Complete').value) : null;
    const cs1Date=(scope==='selected' && isCS1) ? el('cs1Date').value : '';
    if(cs1Index!==null && !cs1Date){el('summary').textContent='Choose a completion date.';return;}
    if(!s){el('summary').textContent='Enter a Sensei name.';return;}
    running=true;buttonsDisabled(true);completed=0;failed=0;cursor=0;el('results').textContent='';
    el('done').hidden=true;el('dayProgress').value=0;
    if(scope==='selected') {
      el('summary').textContent='Processing student... You can close this dialog now.';
      google.script.run.withSuccessHandler(r=>{
        running=false;buttonsDisabled(false);
        google.script.host.close();
      }).withFailureHandler(e=>{running=false;buttonsDisabled(false);
        el('summary').textContent='Error: '+e.message;
      }).generateFromPopup(tab,chosenRow,s,stars,el('notes').value.trim(),cs1Index,cs1Date);
    } else {
      el('summary').textContent='Preparing whole-day update...';
      el('currentAction').textContent='Checking trackers and any new belts that need confirmation.';
      google.script.run.withSuccessHandler(runId=>{
        if(!runId){running=false;buttonsDisabled(false);el('summary').textContent='Cancelled. No trackers changed.';el('currentAction').textContent='';el('done').hidden=false;return;}
        activeDayRun=runId;pollDayProgress(runId);
        processNextBatch(s,runId);
      })
        .withFailureHandler(e=>{running=false;buttonsDisabled(false);el('summary').textContent='Could not start: '+e.message;el('currentAction').textContent='';el('done').hidden=false;})
        .beginDayTrackerRun(tab);
    }
  }
  function stopDayProgress(){
    activeDayRun=null;
    if(progressTimer!==null){clearTimeout(progressTimer);progressTimer=null;}
  }
  function pollDayProgress(runId){
    if(!running || activeDayRun!==runId)return;
    const again=()=>{
      if(running && activeDayRun===runId)progressTimer=setTimeout(()=>pollDayProgress(runId),1500);
    };
    google.script.run.withSuccessHandler(progress=>{
      if(!running || activeDayRun!==runId)return;
      if(progress && progress.name && progress.row===rows[cursor])
        el('currentAction').textContent=progress.name+' — '+progress.stage;
      again();
    }).withFailureHandler(()=>again()).getDayTrackerProgress(tab,runId);
  }
  function processNextBatch(s,runId){
    if(cursor>=rows.length){
      running=false;stopDayProgress();buttonsDisabled(false);
      el('dayProgress').value=rows.length;
      el('summary').textContent='Finished: '+completed+' updated, '+failed+' failed — '+cursor+' of '+rows.length+' students processed.';
      el('currentAction').textContent=failed?'Review the failed students below.':'All tracker updates are complete.';
      el('done').hidden=false;
      return;
    }
    const batch=rows.slice(cursor,cursor+1);
    el('summary').textContent=cursor+' of '+rows.length+' finished — '+completed+' updated, '+failed+' failed.';
    el('currentAction').textContent='Starting '+(studentNames[batch[0]]||'row '+batch[0])+'...';
    google.script.run.withSuccessHandler(results=>{
      results.forEach(r=>{
        if(r.ok)completed++;else failed++;
        addResult('Row '+r.row+' — '+r.name+' — '+(r.ok?(r.message||'Updated'):r.error),r.url||'',!r.ok);
      });
      cursor+=batch.length;
      el('dayProgress').value=cursor;
      processNextBatch(s,runId);
    }).withFailureHandler(e=>{
      running=false;stopDayProgress();buttonsDisabled(false);
      el('summary').textContent='Stopped: '+cursor+' of '+rows.length+' processed — '+completed+' updated, '+failed+' failed.';
      el('currentAction').textContent='Error: '+e.message;
      el('done').hidden=false;
    }).generateDayBatch(tab,batch,s,runId);
  }
  </script></body></html>`;
  SpreadsheetApp.getUi().showModalDialog(
    HtmlService.createHtmlOutput(html).setWidth(490).setHeight(isCS1?750:680),
    'Generate Tracker PDFs ('+TRACKER_GENERATOR_VERSION_+')');
}

// Ask only when a new belt/template is needed. Do this before taking a lock:
// Apps Script alert dialogs suspend execution and do not retain LockService locks.
function confirmNewTrackerBelts_(sheet,rows,allowRowErrors=false) {
  const additions=[];
  for(const row of rows) {
    try {
      const values=sheet.getRange(row,1,1,5).getDisplayValues()[0];
      const student=values[0].trim(),inputCourse=values[3].trim();
      if(!student || !inputCourse) continue;
      const course=getCurriculum_(sheet.getParent(),inputCourse).course;
      const jr=course==='JR'?getLink_(sheet.getRange(row,10)):'';
      const location=locateTracker_(jr||getLink_(sheet.getRange(row,9)),course,student);
      if(!location.file || programFromName_(location.file.getName())!==course) {
        additions.push(student+' — '+course+(location.folder?
          ': add the new tracker to the existing folder.':
          ': create a folder named "'+student+'" with the new tracker'+
          (location.file?' and a copy of the old tracker.':'.')));
      }
    } catch(error) {
      // Day generation reports this row's error and continues with other students.
      if(!allowRowErrors) throw error;
      console.warn('Row '+row+' will be reported during generation: '+error.message);
    }
  }
  if(!additions.length) return true;
  const ui=SpreadsheetApp.getUi();
  return ui.alert('Add new belt tracker?',additions.join('\n')+
    '\n\nContinue? Cancel leaves the trackers unchanged.',ui.ButtonSet.OK_CANCEL)===ui.Button.OK;
}

// One-student popup action. Updates the PDF linked in I (or JR's J).
async function generateFromPopup(tabName,row,sensei,stars,notes,cs1CompleteIndex,cs1CompletionDate) {
  const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(tabName);
  if(!sh || !isDailyTab_(tabName) || row<3) throw new Error('Invalid journal row.');
  sensei=String(sensei||'').trim();
  if(!sensei) throw new Error('Sensei is required.');
  if(!confirmNewTrackerBelts_(sh,[row])) return {cancelled:true};
  const lock=LockService.getDocumentLock()||LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    ensurePdfStatusColumn_(sh);
    const runId=beginTrackerRun_(tabName);
    try {
      return await generateForRow_(sh,row,'W',Number(stars)||0,{
        sensei,notes:String(notes||'').trim(),runId,
        cs1CompleteIndex:cs1CompleteIndex==null ? null : Number(cs1CompleteIndex),
        cs1CompletionDate:String(cs1CompletionDate||'')
      });
    } catch(e) {
      setTrackerIndicator_(sh,row,'FAILED',String(e.message||e));
      throw e;
    }
  } finally {lock.releaseLock();}
}

// HTML-service clients cannot call server functions ending in an underscore.
function beginDayTrackerRun(tabName) { return beginDayTrackerRun_(tabName); }
async function generateDayBatch(tabName,rowNumbers,sensei,runId) {
  return await generateDayBatch_(tabName,rowNumbers,sensei,runId);
}
function dayTrackerProgressKey_() {
  return 'TRACKER_DAY_PROGRESS_'+SpreadsheetApp.getActiveSpreadsheet().getId();
}
function reportDayTrackerProgress_(runId,tab,row,name,stage) {
  try {
    PropertiesService.getScriptProperties().setProperty(dayTrackerProgressKey_(),
      JSON.stringify({runId,tab,row,name,stage,updated:new Date().toISOString()}));
  } catch(error) {console.warn('Progress display could not update: '+error.message);}
}
function getDayTrackerProgress(tabName,runId) {
  const run=lastTrackerRun_();
  if(!run || run.id!==runId || run.tab!==tabName) return null;
  const text=PropertiesService.getScriptProperties().getProperty(dayTrackerProgressKey_());
  if(!text)return null;
  try {const progress=JSON.parse(text);return progress.runId===runId && progress.tab===tabName?progress:null;}
  catch(error){return null;}
}

// Begin a single undoable operation across the multiple server calls of a day batch.
function beginDayTrackerRun_(tabName) {
  const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(tabName);
  if(!sh || !isDailyTab_(tabName)) throw new Error('Invalid daily tab.');
  const rows=[];
  for(let row=3;row<=sh.getLastRow();row++) if(sh.getRange(row,1).getDisplayValue().trim()) rows.push(row);
  if(!confirmNewTrackerBelts_(sh,rows,true)) return null;
  const lock=LockService.getDocumentLock()||LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    ensurePdfStatusColumn_(sh);
    const runId=beginTrackerRun_(tabName);
    reportDayTrackerProgress_(runId,tabName,0,'','Preparing students');
    return runId;
  } finally {lock.releaseLock();}
}

async function generateDayBatch_(tabName,rowNumbers,sensei,runId) {
  const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(tabName);
  if(!sh || !isDailyTab_(tabName)) throw new Error('Invalid journal date tab.');
  if(!Array.isArray(rowNumbers) || rowNumbers.length<1 || rowNumbers.length>2)
    throw new Error('Invalid student batch.');
  sensei=String(sensei||'').trim();
  if(!sensei) throw new Error('Sensei is required.');
  const lock=LockService.getDocumentLock()||LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    assertTrackerRun_(runId,tabName);
    const results=[];
    for(const row of rowNumbers) {
      if(!Number.isInteger(row) || row<3 || row>sh.getLastRow()) {
        results.push({row,name:'Unknown',ok:false,error:'Invalid student row'});continue;
      }
      const name=sh.getRange(row,1).getDisplayValue().trim();
      if(!name){results.push({row,name:'Empty student row',ok:false,error:'Student name was removed.'});continue;}
      try {
        const project=sh.getRange(row,5).getDisplayValue();
        const course=sh.getRange(row,4).getDisplayValue();
        const note=getSuggestedNote_(sh,row,project,course);
        const r=await generateForRow_(sh,row,'W',0,{sensei,notes:note,runId,
          onProgress:stage=>reportDayTrackerProgress_(runId,tabName,row,name,stage)});
        results.push({row,name,ok:true,url:r.url,message:r.message});
      } catch(e) {
        reportDayTrackerProgress_(runId,tabName,row,name,'Failed: '+e.message);
        setTrackerIndicator_(sh,row,'FAILED',String(e.message||e));
        results.push({row,name,ok:false,error:String(e.message||e)});
      }
    }
    return results;
  } finally {lock.releaseLock();}
}

// Status goes in N. Folder mode updates the existing tracker link in I/J only.
function setTrackerIndicator_(sheet,row,label,detail) {
  if(row<3) return;
  ensurePdfStatusColumn_(sheet);
  const color={
    'NOT GENERATED':'#f1f3f4',
    'PDF UPDATED':'#dcfce7',
    'NEEDS UPDATE':'#fff2cc',
    'GENERATING':'#e8e8e8',
    'UNDONE':'#dbeafe',
    'FAILED':'#fce8e6'
  };
  sheet.getRange(row,PDF_STATUS_COLUMN_)
    .setValue(label).setBackground(color[label]||'#ffffff')
    .setNote(detail ? String(detail).slice(0,1500) : '');
}

function installStatusTracking() {
  const sheet=SpreadsheetApp.getActiveSheet();
  if(isDailyTab_(sheet.getName())) initializePdfStatuses_(sheet);
  ScriptApp.getProjectTriggers()
    .filter(t=>t.getHandlerFunction()==='onTrackerProgressEdit_')
    .forEach(t=>ScriptApp.deleteTrigger(t));
  ScriptApp.newTrigger('onTrackerProgressEdit_')
    .forSpreadsheet(SpreadsheetApp.getActiveSpreadsheet()).onEdit().create();
  SpreadsheetApp.getUi().alert('PDF status tracking is enabled. Changes to columns A/E/D/I/J mark N as NEEDS UPDATE. No PDF is edited until you click Generate.');
}
// Retained for people who installed the old trigger. Automatic editing has
// been disabled to avoid unsafe updates without the Sensei popup and undo run.
function installAutoUpdate() { installStatusTracking(); }
function onTrackerProgressEdit_(e) {
  if(!e || !e.range) return;
  const sh=e.range.getSheet();
  if(!isDailyTab_(sh.getName())) return;
  if(![1,4,5,9,10].some(c=>c>=e.range.getColumn() && c<=e.range.getLastColumn())) return;
  const lock=LockService.getDocumentLock()||LockService.getScriptLock();
  if(!lock.tryLock(10000)) return;
  try {
    for(let row=Math.max(3,e.range.getRow());row<=Math.min(sh.getLastRow(),e.range.getLastRow());row++) {
      if(sh.getRange(row,1).getDisplayValue().trim())
        setTrackerIndicator_(sh,row,'NEEDS UPDATE','Journal data changed; regenerate the linked tracker.');
    }
  } finally {lock.releaseLock();}
}

function getCurriculum_(ss, inputCourse) {
  const sh=ss.getSheetByName(CONFIG.COURSES_TAB);
  if(!sh) throw new Error('Missing Courses tab');
  const header=sh.getRange(1,1,1,sh.getLastColumn()).getDisplayValues()[0];
  const column=header.findIndex(x=>norm_(x)===norm_(inputCourse));
  if(column<0) throw new Error('Course not in Courses heading row: '+inputCourse);
  const tasks=sh.getRange(2,column+1,Math.max(1,sh.getLastRow()-1),1)
    .getDisplayValues().map(r=>r[0].trim()).filter(Boolean);
  const course=Object.keys(TRACKER_FIELDS).find(k=>norm_(k)===norm_(header[column]));
  if(!course) throw new Error('No form field map for '+inputCourse);
  return {course,tasks};
}
function getLink_(cell) {
  const r=cell.getRichTextValue();
  if(r) {
    if(r.getLinkUrl()) return r.getLinkUrl();
    for(const run of r.getRuns()) if(run.getLinkUrl()) return run.getLinkUrl();
  }
  const formula=cell.getFormula();
  const m=formula.match(/HYPERLINK\(\s*"([^"]+)"/i);
  if(m) return m[1];
  return cell.getDisplayValue().trim();
}
function getDriveId_(url) {
  const match=String(url||'').match(/(?:\/folders\/|\/file\/d\/|[?&]id=)([A-Za-z0-9_-]+)/);
  if(!match) throw new Error('Expected a Google Drive PDF or folder URL: '+url);
  return match[1];
}
function programFromName_(name) {
  const s=String(name||'').toLowerCase();
  if(/scratch\s*j(?:r|unior)/.test(s)) return 'JR';
  if(/\b(cs\s*1|cs1|cs_1)\b/.test(s)) return 'CS_1';
  const belt=s.match(/\b(white|yellow|orange|green|blue|purple|brown|red|black|bronze|silver|platinum|gold)\s+belt\b/);
  if(!belt) return null;
  const b=belt[1][0].toUpperCase()+belt[1].slice(1);
  if(/unity/.test(s) || ['Bronze','Silver','Platinum','Gold'].includes(b)) return 'UNITY_'+b;
  return 'IMPACT_'+b;
}
function ensureNamedProgram_(file,course,template=false) {
  const inferred=programFromName_(file.getName());
  if(inferred && inferred !== course) throw new Error(
    'Wrong '+(template?'TEMPLATE':'TRACKER')+' FILE: '+file.getName()+' is '+inferred+', not '+course);
  if(!inferred && (template || !CONFIG.ALLOW_UNLABELED_DIRECT_PDFS)) {
    throw new Error('File name does not establish program '+course+': '+file.getName());
  }
}
function isPotentialStudentTracker_(filename, course, student) {
  const lc=filename.toLowerCase();
  if(/\b(empty|blank|template|backup|preview)\b/.test(lc)) return false;
  const p=programFromName_(filename);
  if(p !== course) return false;
  const first=student.toLowerCase().trim().split(/\s+/)[0];
  return Boolean(first) && lc.includes(first);
}
function locateTracker_(url, course, student) {
  if(!String(url||'').trim()) return {file:null,folder:null};
  const id=getDriveId_(url);
  if(/\/folders\//.test(url)) {
    const folder=DriveApp.getFolderById(id), matches=[], candidates=[];
    const files=folder.getFiles();
    while(files.hasNext()) {
      const f=files.next();
      if(f.getMimeType()!==MimeType.PDF || /\b(empty|blank|template|backup|preview)\b/i.test(f.getName())) continue;
      if(programFromName_(f.getName())!==course) continue;
      candidates.push(f);
      if(isPotentialStudentTracker_(f.getName(),course,student)) matches.push(f);
    }
    if(matches.length>1) throw new Error('Multiple '+course+' PDFs match '+student+' in this folder; resolve ambiguity.');
    // A single correctly named belt tracker is safe to try even if the file name
    // lacks the student's name: the PDF name field itself is verified later.
    if(!matches.length && candidates.length===1) return {file:candidates[0],folder};
    if(!matches.length && candidates.length>1) throw new Error('Multiple '+course+' PDFs in folder; cannot select safely.');
    return {file:matches[0]||null,folder};
  }
  const file=DriveApp.getFileById(id);
  if(file.getMimeType()!==MimeType.PDF) throw new Error('The linked tracker must be a PDF.');
  if(Object.values(CONFIG.TEMPLATES).includes(file.getId())) {
    throw new Error('The journal tracker link points to a BLANK TEMPLATE, not a student tracker.');
  }
  const previousCourse=programFromName_(file.getName());
  if(!previousCourse) ensureNamedProgram_(file,course,false);
  return {file,folder:null};
}
function trackerFilename_(student,course) {
  if(course==='JR') return student+' Scratch Jr Tracker.pdf';
  if(course==='CS_1') return student+' CS1 Tracker.pdf';
  const parts=course.split('_');
  return student+' '+parts[1]+' Belt '+parts[0]+' Tracker.pdf';
}

// A belt change uses a clean verified template, never another belt's fields.
// Verify the old PDF belongs to this student before replacing or archiving it.
async function prepareTrackerPdf_(source,previousBytes,course,student,lib) {
  const previousCourse=source ? programFromName_(source.getName()) : null;
  const replaced=Boolean(source && previousCourse && previousCourse!==course);
  if(replaced) {
    const old=await lib.PDFDocument.load(new Uint8Array(previousBytes),{objectsPerTick:Infinity});
    const type=TRACKER_FIELDS[previousCourse].type;
    const name=type==='IMPACT'?'Text1':type==='UNITY'?'Ninjas Name':type==='CS1'?"Student's Name":'Text1';
    setIfBlankOrSame_(fieldOrThrow_(old.getForm(),name),student,'Ninja',true);
  }
  const input=!source || replaced ? verifiedTemplate_(course).getBlob().getBytes() : previousBytes;
  return {pdf:await lib.PDFDocument.load(new Uint8Array(input),{objectsPerTick:Infinity}),replaced};
}

function restoreTrackerLink_(cell,record) {
  if(record.linkFormula) cell.setFormula(record.linkFormula);
  else if(record.linkText && record.linkText!==record.previousLink) {
    cell.setRichTextValue(SpreadsheetApp.newRichTextValue().setText(record.linkText)
      .setLinkUrl(record.previousLink).build());
  } else cell.setValue(record.previousLink);
}

function shareTrackerViewLinks_(file,folder) {
  function alreadyViewable(item) {
    try {
      const access=item.getSharingAccess(),permission=item.getSharingPermission();
      return (access===DriveApp.Access.ANYONE_WITH_LINK || access===DriveApp.Access.ANYONE) &&
        [DriveApp.Permission.VIEW,DriveApp.Permission.COMMENT,DriveApp.Permission.EDIT].includes(permission);
    } catch(error) {return false;}
  }
  function allowViewing(item) {
    // Editors may update an already-public PDF without permission to reshare it.
    // Preserve existing public access, including comment/edit access.
    if(alreadyViewable(item)) return;
    try {item.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);}
    catch(error) {
      // Sharing may have changed or propagated while this operation was running.
      if(alreadyViewable(item)) return;
      throw new Error('Could not enable anyone-with-link viewing for '+item.getName()+': '+error.message);
    }
  }
  if(folder) {
    allowViewing(folder);
    const files=folder.getFiles();
    while(files.hasNext()) {
      const item=files.next();
      if(item.getMimeType()===MimeType.PDF) allowViewing(item);
    }
  } else if(file) allowViewing(file);
}

function persistTrackerPdf_(location,blob,record,runId,createNew,cell,previousLink,previousBytes,previousName,onProgress=()=>{}) {
  const source=location.file;
  if(!createNew) {
    onProgress('Backing up the current tracker');
    const backup=getUndoFolder_().createFile(Utilities.newBlob(previousBytes,'application/pdf','BACKUP '+Date.now()+' '+previousName));
    if(!backup.getId()) throw new Error('Backup failed. Original PDF not changed.');
    let updated=false;
    try {
      onProgress('Enabling anyone-with-link viewing');
      shareTrackerViewLinks_(source,location.folder);
      onProgress('Uploading the updated PDF');
      updateDrivePdf_(source.getId(),blob);
      updated=true;
      if(record.fileName!==previousName) source.setName(record.fileName);
      addTrackerUndoRecord_(runId,Object.assign({},record,{fileId:source.getId(),backupId:backup.getId(),previousFileName:previousName}));
    } catch(error) {
      if(updated) {
        try {updateDrivePdf_(source.getId(),backup.getBlob());source.setName(previousName);}
        catch(restoreError) {throw new Error('Update failed and rollback failed. Backup: '+backup.getUrl()+'. '+restoreError.message);}
      }
      // No successful action references this backup after a completed rollback.
      try {backup.setTrashed(true);} catch(cleanupError) {console.warn('Could not remove unused Undo backup: '+cleanupError.message);}
      throw error;
    }
    return {url:source.getUrl()};
  }
  let folder=location.folder,createdFolder=null,archive=null,created=null,linkChanged=false;
  const linkState={previousLink,linkFormula:cell.getFormula(),linkText:cell.getDisplayValue()};
  try {
    if(!folder) {
      onProgress('Creating the student folder and keeping the old tracker');
      const parents=source?source.getParents():null;
      folder=parents && parents.hasNext()?parents.next().createFolder(record.student):
        DriveApp.createFolder(record.student);
      createdFolder=folder;
      // Copy the previous belt into the history folder; leave its original intact.
      const oldCourse=source?programFromName_(previousName):null;
      // Historical preview prefixes would make folder lookup skip this belt.
      if(source) archive=source.makeCopy(oldCourse?trackerFilename_(record.student,oldCourse):previousName,folder);
    }
    onProgress('Creating the new belt PDF');
    created=folder.createFile(blob);
    if(!created.getId()) throw new Error('Could not create the new belt tracker.');
    // Share the folder and every belt PDF, including the archived old tracker.
    // Do this before publishing its link or marking the operation successful.
    onProgress('Enabling anyone-with-link viewing');
    shareTrackerViewLinks_(created,folder);
    onProgress('Updating the tracker link in the journal');
    const folderUrl=folder.getUrl();
    linkChanged=true;
    cell.setValue(folderUrl);
    addTrackerUndoRecord_(runId,Object.assign({},record,linkState,{
      created:true,fileId:created.getId(),folderId:folder.getId(),
      createdFolderId:createdFolder?createdFolder.getId():null,
      archiveId:archive?archive.getId():null,archiveHash:archive?hashPdfBytes_(previousBytes):null,
      linkColumn:cell.getColumn(),afterLink:folderUrl
    }));
    return {url:folderUrl};
  } catch(error) {
    try {
      if(linkChanged) restoreTrackerLink_(cell,linkState);
      if(created) created.setTrashed(true);
      if(archive) archive.setTrashed(true);
      if(createdFolder) createdFolder.setTrashed(true);
    } catch(restoreError) {throw new Error('Folder update failed and cleanup failed: '+restoreError.message+'. '+error.message);}
    throw error;
  }
}

function undoCreatedTracker_(rec,file,ss) {
  const sh=ss.getSheetByName(rec.tab);
  if(!sh || sh.getRange(rec.row,1).getDisplayValue().trim()!==rec.student)
    throw new Error('Student row changed; folder and link left unchanged.');
  const cell=sh.getRange(rec.row,rec.linkColumn);
  if(getLink_(cell)!==rec.afterLink) throw new Error('Tracker link changed since generation; left unchanged.');
  const archive=rec.archiveId?DriveApp.getFileById(rec.archiveId):null;
  if(archive && hashPdfBytes_(archive.getBlob().getBytes())!==rec.archiveHash)
    throw new Error('Archived tracker changed since generation; left unchanged.');
  restoreTrackerLink_(cell,rec);
  file.setTrashed(true);
  if(archive) archive.setTrashed(true);
  if(rec.createdFolderId) {
    const folder=DriveApp.getFolderById(rec.createdFolderId);
    // Do not trash a folder if someone added other files or subfolders.
    if(!folder.getFiles().hasNext() && !folder.getFolders().hasNext()) folder.setTrashed(true);
  }
}

// Template links may have been pasted in a different order to the filenames.
// Resolve them using what the files ACTUALLY say in Drive, not the guessed keys.
function verifiedTemplate_(course) {
  const firstId=CONFIG.TEMPLATES[course];
  if(!firstId) throw new Error('No template ID entered for '+course);
  const first=DriveApp.getFileById(firstId);
  if(programFromName_(first.getName())===course) {
    if(first.getMimeType()!==MimeType.PDF) throw new Error('Template is not a PDF: '+first.getName());
    return first;
  }
  const matches=[];
  const seen={};
  for(const id of Object.values(CONFIG.TEMPLATES)) {
    if(seen[id]) continue;
    seen[id]=true;
    const file=DriveApp.getFileById(id);
    if(programFromName_(file.getName())===course && file.getMimeType()===MimeType.PDF) {
      matches.push(file);
    }
  }
  if(matches.length===1) return matches[0];
  throw new Error('Template links are mixed up: expected '+course+', but '+
    first.getName()+' was supplied. '+(matches.length>1?'Multiple candidate PDFs exist.':'No matching PDF was found among your 15 links.')+
    ' Open Tracker PDFs > Audit Template Filenames for details.');
}
function auditTemplateNames() {
  const lines=[];
  Object.keys(CONFIG.TEMPLATES).forEach(key=>{
    try {
      const f=DriveApp.getFileById(CONFIG.TEMPLATES[key]);
      const found=programFromName_(f.getName());
      lines.push((found===key?'OK':'NEEDS REORDERING')+' '+key+' -> '+f.getName()+
        (found===key?'':' [actual program: '+(found||'unknown')+']'));
    } catch(e) {lines.push('UNAVAILABLE '+key+': '+e.message);}
  });
  Logger.log(lines.join('\n'));
  SpreadsheetApp.getUi().alert('The file-ID audit checks whether each link belongs to its belt.\n'+
    'The PDF generator automatically finds the correct template by its filename when possible.\n'+
    'No files were changed.\n\n'+lines.slice(0,8).join('\n')+'\n\nFull results: Apps Script > Executions.');
}

function getPdfLib_() {
  if(PDF_LIB_CACHE_) return PDF_LIB_CACHE_;
  const source=UrlFetchApp.fetch(CONFIG.PDF_LIB_URL).getContentText();
  PDF_LIB_CACHE_=eval(source+'\n;PDFLib;');
  if(!PDF_LIB_CACHE_ || !PDF_LIB_CACHE_.PDFDocument) throw new Error('Unable to initialize pdf-lib');
  return PDF_LIB_CACHE_;
}
function fieldOrThrow_(form, name, type) {
  try {
    if(type==='dropdown') return form.getDropdown(name);
    if(type==='check') return form.getCheckBox(name);
    return form.getTextField(name);
  } catch(e) {throw new Error('Missing or incorrect PDF field '+name+': '+e.message);}
}
function readDropdown_(field) {
  const value=field.getSelected();
  return (Array.isArray(value)?value[0]:value)||'';
}
// force=true for a field deliberately targeted by this session: current W,
// preceding C, or an earned level-up L. Unlike the old implementation, an
// existing C no longer blocks replacement with the CURRENT project's W.
// Earlier explicit S/C history is otherwise preserved.
function updateDropdown_(form,name,status,warnings,force=false) {
  const f=fieldOrThrow_(form,name,'dropdown');
  const opts=f.getOptions();
  // Some templates offer a space as the blank option; others have no blank
  // option at all. pdf-lib clear() removes both the value and its appearance.
  if(!String(status).trim() && !opts.includes(status)) {
    f.clear();
    return;
  }
  if(!opts.includes(status)) {
    throw new Error('Cannot set '+status+' for PDF field '+name+
      ' (allowed: '+opts.join(', ')+'). The original tracker was not changed.');
  }
  const old=readDropdown_(f);
  if(old===status) {
    // Re-select to mark its appearance dirty. Previously some existing values
    // had stale appearance streams even though /V already contained C/W/L.
    f.select(status);
    return;
  }
  if(!force && old==='C' && status!=='C') {
    warnings.push('Preserved earlier completed activity in '+name);
    return;
  }
  if(!force && old==='S' && status!=='S') {
    warnings.push('Preserved earlier skipped activity in '+name);
    return;
  }
  f.select(status);
}
function setIfBlankOrSame_(field, value, label, strict=false) {
  const old=(field.getText()||'').trim();
  if(!old || norm_(old)===norm_(value)) {field.setText(value);return;}
  if(strict) {
    // E.g., Jack S and Jack Sorensen are compatible by first name + last initial.
    const p=old.trim().toLowerCase().split(/\s+/);
    const q=value.trim().toLowerCase().split(/\s+/);
    if(p[0]!==q[0] || (p[1] && q[1] && p[1][0]!==q[1][0])) {
      throw new Error('Student name in PDF ('+old+') differs from journal ('+value+'). Aborting.');
    }
  }
  field.setText(value);
}
// Replace the value of an existing fillable note field, rather than adding
// new text after old text. This avoids repeated entries on every PDF update.
function replaceNoteField_(field,text) {
  if(!field) return false;
  const updated=String(text||'').trim();
  if(String(field.getText()||'')!==updated) field.setText(updated);
  return true;
}
function tryNoteField_(form,name,note,warnings) {
  if(!name) return false;
  try {
    return replaceNoteField_(form.getTextField(name),note);
  } catch(e) {
    warnings.push('Note field unavailable '+name+': '+e.message);
    return false;
  }
}

// The IMPACT tracker has two editable Notes lines. BOTH fields are reset
// before writing the replacement so an older second line cannot remain.
// Unrelated progress dropdowns, completion dates and other PDF pages
// are left unchanged. An overly long note errors before any file is saved.
function writeImpactNotes_(form,note,warnings) {
  const text=String(note||'').trim();
  if(!text) return;  // Empty popup note means leave the previous note untouched.

  const maxLine=55; // conservative length for these 12pt PDF form fields
  let a=text, b='';
  if(text.length>maxLine) {
    let split=text.lastIndexOf(' ',maxLine);
    if(split<=0) split=maxLine;
    a=text.slice(0,split).trim();
    b=text.slice(split).trim();
    if(b.length>maxLine) {
      throw new Error('Notes are too long for the two IMPACT Notes fields (max about 110 characters). Shorten the note before updating.');
    }
  }

  // Read both fields before mutating either one, so a missing field
  // cannot leave only half of a replacement in the in-memory PDF.
  const top=fieldOrThrow_(form,'Text3');
  const bottom=fieldOrThrow_(form,'Text4');
  replaceNoteField_(top,a);
  replaceNoteField_(bottom,b); // clears old line 2, if any
}
function checkboxStatus_(form,name) {
  return fieldOrThrow_(form,name,'check').isChecked();
}

// A later IMPACT level means the earlier levels have been finished.
// Keep previously recorded S values and C/L fields; never blank existing progress.
function completePreviousImpactLevels_(form,meta,currentLevel,warnings) {
  for(let level=0;level<currentLevel-1;level++) {
    const names=meta.levels[level];
    for(const name of names) {
      if(names.filter(n=>n===name).length>1) {
        warnings.push('Ambiguous duplicate field '+name+'; previous level marker not changed.');
        continue;
      }
      const f=fieldOrThrow_(form,name,'dropdown');
      const options=f.getOptions();
      const old=readDropdown_(f);
      // Usually work/discovery activity fields allow C, while final level-up allows L.
      // Never overwrite a skipped activity: S is an intentional historic decision.
      if(options.includes('C')) {
        if(old!=='S') updateDropdown_(form,name,'C',warnings,true);
      } else if(options.includes('L')) {
        updateDropdown_(form,name,'L',warnings,true);
      }
    }
  }
}

function getProgressSnapshot_(form,meta) {
  const names = meta.type==='IMPACT'
    ? meta.levels.flat() : meta.rows.map(row=>row.status);
  const result={};
  for(const name of new Set(names)) {
    result[name]=readDropdown_(fieldOrThrow_(form,name,'dropdown'));
  }
  return result;
}

// Resolve once for both writing and save-time validation. Blue fields follow
// the printed icons: level circle, Discovery globe, Solve wrenches, trophy.
// Blue 6 has only Solve wrenches and a trophy. Curriculum list order must not
// shift numbered Solve projects when Discovery or other entries are present.
function impactTarget_(form,meta,course,task,allTasks) {
  const match=task.match(/^Lvl\s+(\d+)\s+(.+)$/i);
  const level=match?Number(match[1]):1;
  const activity=match?match[2]:task;
  const names=meta.levels[level-1];
  if(!names) throw new Error('Tracker has no level '+level+' for '+course);
  const isQuest=/^(quest|adventure)/i.test(activity);
  if(isQuest) {
    const name=names[names.length-1];
    if(names.filter(n=>n===name).length!==1)
      throw new Error('Ambiguous Quest/Adventure field for '+task+'. Original tracker was not changed.');
    return {name,position:names.length-1,isQuest:true};
  }
  // Many Courses entries share the limited activity markers printed on a belt.
  // Keep the quest separate even after its dropdown has gained a W option.
  const fields=names.filter((n,i)=>i<names.length-1 && names.filter(x=>x===n).length===1 &&
    fieldOrThrow_(form,n,'dropdown').getOptions().includes('W'));
  let position,shared=false;
  if(course==='IMPACT_Blue') {
    const solve=activity.match(/^Solve\s+(\d+)\b/i);
    if(solve) position=(level===6?0:2)+Number(solve[1])-1;
    else if(/^discover(?:y)?\b/i.test(activity) && level!==6) position=1;
  }
  if(position===undefined) {
    const entries=allTasks.filter(t=>new RegExp('^Lvl\\s+'+level+'\\s+','i').test(t))
      .filter(t=>!/^Lvl\s+\d+\s+(quest|adventure)/i.test(t));
    const index=entries.findIndex(t=>norm_(t)===norm_(task));
    if(index<0) throw new Error('Project not found within IMPACT level '+level+': '+task);
    const hasDiscovery=entries.some(t=>/^Lvl\s+\d+\s+discover(?:y)?\b/i.test(t));
    const offset=hasDiscovery || (course==='IMPACT_Blue' && level===6)?0:1;
    const slot=Math.min(index+offset,fields.length-1);
    shared=index+offset>=fields.length;
    position=names.indexOf(fields[slot]);
  }
  // Numbered Blue Solve entries can also outnumber the working slots.
  // Use the last valid activity marker, never the quest or an ambiguous field.
  if(fields.length && !fields.includes(names[position])) {
    position=names.indexOf(fields[fields.length-1]);
    shared=true;
  }
  const name=names[position];
  if(!name || names.filter(n=>n===name).length!==1 ||
     !fieldOrThrow_(form,name,'dropdown').getOptions().includes('W')) {
    throw new Error('No unambiguous working slot for '+task+'. Original tracker was not changed.');
  }
  return {name,position,isQuest:false,shared};
}

function applyImpact_(form,meta,course,task,allTasks,status,sensei,date,student,notes,warnings) {
  setIfBlankOrSame_(fieldOrThrow_(form,'Text1'),student,'Ninja',true);
  fieldOrThrow_(form,'Text2').setText(sensei);
  fieldOrThrow_(form,'Date3_af_date').setText(date.short);
  const levelMatch=task.match(/^Lvl\s+(\d+)\s+(.+)$/i);
  const level=levelMatch?Number(levelMatch[1]):1;
  if(level<1 || level>meta.levels.length) throw new Error('Tracker has no level '+level+' for '+course);
  completePreviousImpactLevels_(form,meta,level,warnings);
  // A project can move backwards as well as forwards. Reconcile later levels
  // too, otherwise their old W markers survive beside the new current W.
  // The journal project defines progress; retain explicit skips and avoid ambiguous fields.
  for(let later=level;later<meta.levels.length;later++) {
    const names=meta.levels[later];
    for(const name of new Set(names)) {
      if(names.filter(n=>n===name).length>1) continue;
      const old=readDropdown_(fieldOrThrow_(form,name,'dropdown'));
      if(old && old.trim() && old!=='S') updateDropdown_(form,name,' ',warnings,true);
    }
  }
  const target=impactTarget_(form,meta,course,task,allTasks);
  if(target.isQuest) {
    const quest=fieldOrThrow_(form,target.name,'dropdown');
    // Original templates allow only R/L/blank. Extend this student's field so
    // an active quest can show W; never edit the shared template or award L.
    if(!quest.getOptions().includes('W')) quest.addOptions('W');
  }
  const names=meta.levels[level-1];
  for(const name of new Set(names)) {
    if(names.filter(n=>n===name).length>1) continue;
    const old=readDropdown_(fieldOrThrow_(form,name,'dropdown'));
    const position=names.indexOf(name);
    if(name===target.name) updateDropdown_(form,name,'W',warnings,true);
    else if(position<target.position) {
      const options=fieldOrThrow_(form,name,'dropdown').getOptions();
      if(old!=='S' && options.includes('C')) updateDropdown_(form,name,'C',warnings,true);
      else if(old==='W' || old==='R') updateDropdown_(form,name,' ',warnings,true);
    } else if(!target.isQuest && old && old.trim() && old!=='S') {
      updateDropdown_(form,name,' ',warnings,true);
    }
  }
  // Use the Sensei's popup notes if provided, otherwise retain the standard progress note.
  if(target.shared) warnings.push('Multiple projects share the final activity marker; Notes identify the exact current project.');
  const note=target.shared && !norm_(notes).includes(norm_(task))
    ? 'Working on '+task+'!'+(notes?' '+notes:'')
    : notes || (date.short+' '+sensei+': '+status+' '+task);
  writeImpactNotes_(form,note,warnings);
}
function applyUnity_(form,meta,index,status,sensei,date,student,notes,warnings) {
  setIfBlankOrSame_(fieldOrThrow_(form,'Ninjas Name'),student,'Ninja',true);
  const row=meta.rows[index];
  if(!row) throw new Error('Unity tracker has no row '+(index+1));
  // Reconcile Unity markers too: move an earlier W to C when the ninja
  // advances, clear stray future W values, and force today's current slot to W.
  // Do not change explicit C/S history in unrelated project rows.
  for(let i=0;i<meta.rows.length;i++) {
    const name=meta.rows[i].status;
    const old=readDropdown_(fieldOrThrow_(form,name,'dropdown'));
    if(i===index) updateDropdown_(form,name,'W',warnings,true);
    else if(old==='W') updateDropdown_(form,name,i<index?'C':' ',warnings,true);
  }
  if(String(notes||'').trim()) {
    // Replace the previous note in this same project row; never append.
    tryNoteField_(form,row.note,String(notes).trim(),warnings);
  } else {
    // Earlier generator versions wrote generic "Working on Chef Codey!" notes.
    // Remove only that exact autogenerated pattern, not real instructor notes.
    try {
      const f=form.getTextField(row.note);
      if(/^Working on .+!$/i.test(String(f.getText()||'').trim())) f.setText('');
    } catch(e) { /* No editable Notes field on this row. */ }
  }
}
// CS1 has one checkbox, date and By field per project. In the selected
// student's PDF, the CURRENT journal project always remains unchecked (W).
// Never replace an existing completion or write over a historical By note.
function applyCS1_(form,meta,index,status,sensei,date,student,notes,warnings) {
  setIfBlankOrSame_(fieldOrThrow_(form,"Student's Name"),student,'Ninja',true);
  const row=meta.rows[index];
  if(!row) throw new Error('CS1 tracker has no current project row '+(index+1));
  if(notes && !/^Working on .+!$/i.test(notes)) warnings.push('CS1 has no general Notes field; custom notes were not written.');
  if(checkboxStatus_(form,row.check)) {
    warnings.push('The journal current project is already checked as completed in the PDF; kept its existing history.');
    return;
  }
  // Show the current W using the PDF's By note and the journal date, not a
  // completion checkmark. Existing notes and dates are never overwritten.
  if(row.by) {
    const by=fieldOrThrow_(form,row.by);
    const old=String(by.getText()||'').trim();
    if(!old || /^working!?$/i.test(old)) by.setText('Working!');
    else warnings.push('Kept existing By note on current CS1 project: '+old);
  }
  if(row.date) {
    const dateField=fieldOrThrow_(form,row.date);
    if(!String(dateField.getText()||'').trim()) dateField.setText(date.short);
  }
}

// Only the explicitly selected CS1 project is marked complete.
// If it was previously completed, its original date and By remain untouched.
function completeSelectedCS1_(form,meta,chosenIndex,currentIndex,completionDate,sensei,warnings) {
  if(chosenIndex===null || chosenIndex===undefined) return;
  if(!Number.isInteger(chosenIndex) || chosenIndex<0 || chosenIndex>=meta.rows.length) {
    throw new Error('Invalid CS1 completion project selection.');
  }
  if(chosenIndex===currentIndex) throw new Error(
    'The current project from column E must remain Work in Progress. Choose a different project to complete, or None.');
  const row=meta.rows[chosenIndex];
  if(checkboxStatus_(form,row.check)) {
    warnings.push('Selected CS1 activity was already completed; its original date and By were preserved.');
    return;
  }
  const shortDate=formatCompletionDate_(completionDate);
  const dateField=row.date ? fieldOrThrow_(form,row.date) : null;
  const byField=row.by ? fieldOrThrow_(form,row.by) : null;
  // Existing annotations might have been entered manually while unchecked.
  // Do not silently overwrite them. Ask staff to resolve the conflict.
  const wasWorking=byField && /^working!?$/i.test(String(byField.getText()||'').trim());
  if(dateField && !wasWorking && String(dateField.getText()||'').trim() &&
      String(dateField.getText()).trim()!==shortDate) {
    throw new Error('Selected CS1 row already has a different date; resolve it manually before marking completed.');
  }
  if(byField && String(byField.getText()||'').trim() &&
      norm_(byField.getText())!==norm_(sensei) &&
      !/^working!?$/i.test(String(byField.getText()).trim())) {
    throw new Error('Selected CS1 row already has a different By note; resolve it manually before marking completed.');
  }
  if(dateField) dateField.setText(shortDate);
  if(byField) byField.setText(sensei);
  fieldOrThrow_(form,row.check,'check').check();
}
function metaInvalidStars_(stars) {
  return !Number.isInteger(Number(stars)) || Number(stars)<0 || Number(stars)>3;
}
function applyJR_(form,meta,index,status,stars,sensei,date,student,notes,warnings) {
  if(!CONFIG.ALLOW_JR_INDEX_MAPPING) {
    throw new Error('Scratch Jr row-number mapping is disabled. Enable ALLOW_JR_INDEX_MAPPING to match the first 40 entries.');
  }
  setIfBlankOrSame_(fieldOrThrow_(form,'Text1'),student,'Ninja',true);
  const row=meta.rows[index];
  if(!row || index>=40) throw new Error('Scratch Jr PDF supports only the first 40 journal activities. Activity '+(index+1)+' cannot be placed on this tracker.');
  // Scratch Jr has no W dropdown. A W session is recorded in Comments.
  // Optional stars are only recorded when explicitly selected in the JR popup.
  // Preserve all previously checked stars; never remove historic ratings.
  if(stars>0) {
    if(!Number.isInteger(stars) || stars>3) throw new Error('Scratch Jr stars must be 1, 2 or 3.');
    for(let i=0;i<stars;i++) fieldOrThrow_(form,row.stars[i],'check').check();
  }
  tryNoteField_(form,row.comment,notes || (date.short+' '+sensei+': '+status),warnings);
}

async function generateForRow_(sh,row,status,stars,overrides) {
  const values=sh.getRange(row,1,1,5).getDisplayValues()[0];
  const student=values[0].trim(), inputCourse=values[3].trim(), project=values[4].trim();
  const sensei=String((overrides && overrides.sensei)||'').trim();
  const forJr=norm_(inputCourse)==='jr';
  const jrLink=forJr ? getLink_(sh.getRange(row,10)) : '';
  const trackerUrl=jrLink || getLink_(sh.getRange(row,9));
  const trackerCol=jrLink ? 'J' : 'I';
  const notes=String(overrides && overrides.notes !== undefined
    ? overrides.notes : defaultProjectNote_(project,inputCourse)).trim();
  const runId=overrides && overrides.runId;
  const progress=overrides && typeof overrides.onProgress==='function'?overrides.onProgress:()=>{};
  if(!student || !inputCourse || !project || !sensei)
    throw new Error('Missing student A, program D, project E, or popup Sensei.');
  if(!runId) throw new Error('Undo session was not initialized. Use the Generate PDF popup.');
  assertTrackerRun_(runId,sh.getName());
  status='W';
  if(metaInvalidStars_(stars)) throw new Error('Invalid star count.');
  const date=getSessionDate_(sh), curriculum=getCurriculum_(sh.getParent(),inputCourse);
  const course=curriculum.course, meta=TRACKER_FIELDS[course];
  const idx=curriculum.tasks.findIndex(t=>norm_(t)===norm_(project));
  if(idx<0) throw new Error(project+' is not in Courses for '+course);
  const task=curriculum.tasks[idx];
  const chosenCS1=overrides && overrides.cs1CompleteIndex != null
    ? overrides.cs1CompleteIndex : null;
  const chosenDate=overrides && overrides.cs1CompletionDate || '';
  if(chosenCS1!==null) {
    if(meta.type!=='CS1' || !Number.isInteger(chosenCS1)
       || chosenCS1<0 || chosenCS1>=curriculum.tasks.length)
      throw new Error('Invalid CS1 completion project.');
    if(chosenCS1===idx) throw new Error('Current CS1 project stays W; select another project to complete.');
    formatCompletionDate_(chosenDate);
  }
  if(meta.type!=='JR') stars=0;

  setTrackerIndicator_(sh,row,'GENERATING','Updating '+student+' / '+project);
  progress('Finding the student tracker');
  const location=locateTracker_(trackerUrl,course,student);
  const source=location.file;
  if(source && Object.values(CONFIG.TEMPLATES).includes(source.getId()))
    throw new Error('The tracker link refers to a shared blank template. Use a student-specific tracker PDF.');
  const previousName=source ? source.getName() : '';
  const previousBytes=source ? source.getBlob().getBytes() : null;
  const lib=getPdfLib_();
  progress('Loading the PDF and checking its belt');
  const prepared=await prepareTrackerPdf_(source,previousBytes,course,student,lib);
  const pdf=prepared.pdf;
  const form=pdf.getForm(), warnings=[];
  const createNew=!source || prepared.replaced;
  const outputName=prepared.replaced || !source ? trackerFilename_(student,course) : previousName;
  progress('Filling project markers and notes');
  if(meta.type==='IMPACT') applyImpact_(form,meta,course,task,curriculum.tasks,status,sensei,date,student,notes,warnings);
  else if(meta.type==='UNITY') applyUnity_(form,meta,idx,status,sensei,date,student,notes,warnings);
  else if(meta.type==='CS1') {
    applyCS1_(form,meta,idx,status,sensei,date,student,notes,warnings);
    completeSelectedCS1_(form,meta,chosenCS1,idx,chosenDate,sensei,warnings);
  } else if(meta.type==='JR') {
    if(idx>=40) throw new Error('Scratch Jr tracker supports only 40 activities, not #'+(idx+1));
    applyJR_(form,meta,idx,status,stars,sensei,date,student,notes,warnings);
  }
  progress('Saving and validating PDF markers');
  // Snapshot the complete set of IMPACT/Unity progress values before serialization.
  // Verification below checks every field, not only the current W.
  const expectedProgress = (meta.type==='IMPACT' || meta.type==='UNITY')
    ? getProgressSnapshot_(form,meta) : null;
  // Regenerate widget appearances after changing dropdown selections.
  // This updates the visible C/W/L glyphs as well as their underlying /V values.
  // Keep fields editable; flattening would prevent later updates and Undo edits.
  if(meta.type==='IMPACT' || meta.type==='UNITY') {
    const font=await pdf.embedFont(lib.StandardFonts.Helvetica);
    form.updateFieldAppearances(font);
  }
  const newBytes=await pdf.save({objectsPerTick:Infinity});
  // Verify round-trip form values before touching the student's Drive file.
  if(meta.type==='IMPACT' || meta.type==='UNITY') {
    const checked=await lib.PDFDocument.load(newBytes,{objectsPerTick:Infinity});
    const checkForm=checked.getForm();
    const actualProgress=getProgressSnapshot_(checkForm,meta);
    for(const key of Object.keys(expectedProgress)) {
      if(expectedProgress[key]!==actualProgress[key]) {
        throw new Error('Progress marker '+key+' failed to save: expected '+
          expectedProgress[key]+' but found '+actualProgress[key]+'. '+
          'The original tracker has not been changed.');
      }
    }
    if(meta.type==='IMPACT') {
      const target=impactTarget_(checkForm,meta,course,task,curriculum.tasks);
      if(target.name && readDropdown_(checkForm.getDropdown(target.name))!=='W')
        throw new Error('PDF validation failed: current project did not save as W. Original was not changed.');
    } else {
      const field=meta.rows[idx].status;
      if(readDropdown_(checkForm.getDropdown(field))!=='W')
        throw new Error('PDF validation failed: Unity current project did not save as W. Original was not changed.');
    }
  }
  const blob=Utilities.newBlob(Array.from(new Int8Array(newBytes)),
    'application/pdf',outputName);
  const statusBefore=sh.getRange(row,PDF_STATUS_COLUMN_).getDisplayValue();

  const record={tab:sh.getName(),row,student,project:task,statusBefore,
    fileName:outputName,afterHash:hashPdfBytes_(blob.getBytes())};
  const result=persistTrackerPdf_(location,blob,record,runId,createNew,
    sh.getRange(row,trackerCol==='J'?10:9),trackerUrl,previousBytes,previousName,progress);
  setTrackerIndicator_(sh,row,'PDF UPDATED',
    'Updated '+outputName+' on '+date.short+' using '+TRACKER_GENERATOR_VERSION_+
    '. Undo available from Tracker PDFs menu.');
  progress('Completed');
  return {
    url:result.url,message:(createNew?'Created tracker in folder.':prepared.replaced?'Replaced tracker with '+course+' template.':'Updated existing tracker PDF.')+
      (warnings.length?' Warnings: '+warnings.join(' | '):'')
  };
}

// -----------------------------------------------
// ONE-CLICK UNDO — restore files from Drive backups
// -----------------------------------------------
function trackerRunKey_() {
  return 'TRACKER_LAST_UNDO_RUN_'+SpreadsheetApp.getActiveSpreadsheet().getId();
}
function lastTrackerRun_() {
  const raw=PropertiesService.getScriptProperties().getProperty(trackerRunKey_());
  if(!raw) return null;
  try {return JSON.parse(raw);} catch(e) {return null;}
}
// List the actual students and PDF filenames that Undo would restore.
// Read-only: does not touch any student tracker or alter journal columns.
function getUndoPreview_(run) {
  if(!run || !run.id || !run.count) return [];
  const props=PropertiesService.getScriptProperties();
  const result=[];
  const seen=new Set();
  for(let i=0;i<run.count;i++) {
    const raw=props.getProperty(undoRecordKey_(run.id,i));
    if(!raw) continue; // already undone or no longer present
    try {
      const rec=JSON.parse(raw);
      if(!rec.fileId || seen.has(rec.fileId)) continue;
      seen.add(rec.fileId);
      result.push({student:String(rec.student||'Student row '+rec.row),
        fileName:String(rec.fileName||'Tracker PDF'),
        project:String(rec.project||'')});
    } catch(error) {console.warn('Unreadable undo record '+i+': '+error.message);}
  }
  return result;
}
function beginTrackerRun_(tab) {
  // Register the previous successful run when upgrading from older versions.
  retainTrackerUndoRun_(lastTrackerRun_());
  const run={id:Utilities.getUuid().replace(/-/g,''),tab,
    started:new Date().toISOString(),count:0};
  PropertiesService.getScriptProperties()
    .setProperty(trackerRunKey_(),JSON.stringify(run));
  return run.id;
}
function assertTrackerRun_(runId,tab) {
  const run=lastTrackerRun_();
  if(!run || run.id!==runId || run.tab!==tab)
    throw new Error('Another tracker update started. Run Generate again to avoid mixing undo histories.');
  return run;
}
function undoRecordKey_(runId,index) {
  return 'TRACKER_UNDO_'+runId+'_'+index;
}
function addTrackerUndoRecord_(runId,record) {
  const run=assertTrackerRun_(runId,record.tab);
  const props=PropertiesService.getScriptProperties();
  props.setProperty(undoRecordKey_(runId,run.count),JSON.stringify(record));
  run.count++;
  props.setProperty(trackerRunKey_(),JSON.stringify(run));
  retainTrackerUndoRun_(run);
}
function trackerUndoHistoryKey_() {
  return 'TRACKER_UNDO_HISTORY_'+SpreadsheetApp.getActiveSpreadsheet().getId();
}
function retainTrackerUndoRun_(run) {
  if(!run || !run.id || !run.count) return;
  // Cleanup must not turn a successfully saved tracker into a failed update.
  try {
    const props=PropertiesService.getScriptProperties(),key=trackerUndoHistoryKey_();
    const raw=props.getProperty(key);
    const history=raw?JSON.parse(raw):[];
    if(!Array.isArray(history)) throw new Error('Invalid Undo retention history.');
    const previous=history.find(item=>item.id===run.id);
    if(previous) previous.count=Math.max(previous.count,run.count);
    else history.push({id:run.id,count:run.count});
    // Persist tracking before Drive calls so cleanup can be retried after failure.
    props.setProperty(key,JSON.stringify(history));
    const expired=history.slice(0,-TRACKER_UNDO_ACTION_LIMIT_);
    const recent=history.slice(-TRACKER_UNDO_ACTION_LIMIT_),retry=[];
    for(const item of expired) {
      let finished=true;
      for(let index=0;index<item.count;index++) {
        const recordKey=undoRecordKey_(item.id,index),text=props.getProperty(recordKey);
        if(!text) continue;
        try {
          const record=JSON.parse(text);
          // Only recorded Undo backup files may be removed. Never touch the
          // student PDF, archived belt copy, new tracker or configured template.
          if(record.backupId) {
            if(record.backupId===record.fileId || Object.values(CONFIG.TEMPLATES).includes(record.backupId))
              throw new Error('Undo backup ID refers to a tracker or template.');
            const backup=DriveApp.getFileById(record.backupId);
            const folderId=props.getProperty('TRACKER_PDF_UNDO_FOLDER');
            const parents=backup.getParents();let inUndoFolder=false;
            while(parents.hasNext()) if(parents.next().getId()===folderId) inUndoFolder=true;
            if(!folderId || !inUndoFolder || !/^BACKUP\s/.test(backup.getName()))
              throw new Error('File is not a recognized Undo backup in the Undo folder.');
            if(!backup.isTrashed()) backup.setTrashed(true);
          }
          props.deleteProperty(recordKey);
        } catch(error) {finished=false;console.warn('Undo backup cleanup will retry: '+error.message);}
      }
      if(!finished) retry.push(item);
    }
    props.setProperty(key,JSON.stringify(retry.concat(recent)));
  } catch(error) {console.warn('Undo backup retention could not complete: '+error.message);}
}
function getUndoFolder_() {
  const props=PropertiesService.getScriptProperties();
  const existing=props.getProperty('TRACKER_PDF_UNDO_FOLDER');
  if(existing) {
    try {return DriveApp.getFolderById(existing);} catch(error) {}
  }
  const folder=DriveApp.createFolder('Tracker PDF Undo Backups');
  props.setProperty('TRACKER_PDF_UNDO_FOLDER',folder.getId());
  return folder;
}
function hashPdfBytes_(bytes) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,bytes)
    .map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');
}

// Optional menu/Sheets button action. Also available directly in the popup.
function undoLastTrackerUpdate() {
  const ui=SpreadsheetApp.getUi();
  const run=lastTrackerRun_();
  if(!run || !run.count) {
    ui.alert('Nothing to undo','No tracker PDFs were updated in the last run.',ui.ButtonSet.OK);
    return;
  }
  const people=getUndoPreview_(run).map(item=>item.student+' — '+item.fileName).join('\n');
  const response=ui.alert('Undo tracker PDF changes?',
    'Restore these PDF trackers from the last update on '+run.tab+'?\n\n'+people+'\n\n'+
    'PDFs changed again since that update will be skipped for safety.',
    ui.ButtonSet.YES_NO);
  if(response!==ui.Button.YES) return;
  const result=restoreLastTrackerRun_(run.id);
  ui.alert('Undo result',result.message,ui.ButtonSet.OK);
}

// Called by the Undo Last PDF Update button inside the HTML popup.
// The runId binds the action to the operation shown when the popup opened.
function undoLastTrackerUpdateFromPopup(runId) {
  const result=restoreLastTrackerRun_(String(runId || ''));
  SpreadsheetApp.getActiveSpreadsheet().toast(result.message,'Tracker PDF Undo',8);
  return result;
}

// Restores the PDF bytes that were backed up before the last operation.
// Files modified after generation are skipped to avoid overwriting newer edits.
// Only column N (PDF STATUS) is updated on the sheet.
function restoreLastTrackerRun_(expectedRunId) {
  const lock=LockService.getDocumentLock()||LockService.getScriptLock();
  lock.waitLock(30000);
  try {
    const run=lastTrackerRun_();
    if(!run || !run.count) throw new Error('No PDF updates are available to undo.');
    if(run.id!==expectedRunId)
      throw new Error('A newer tracker update replaced this undo session. Reopen the popup and try again.');
    const props=PropertiesService.getScriptProperties();
    const ss=SpreadsheetApp.getActiveSpreadsheet();
    let restored=0,skipped=0;
    const errors=[];
    // Reverse order matters when multiple journal rows reference the same PDF.
    for(let i=run.count-1;i>=0;i--) {
      const key=undoRecordKey_(run.id,i);
      const text=props.getProperty(key);
      if(!text) continue;
      const rec=JSON.parse(text);
      try {
        const file=DriveApp.getFileById(rec.fileId);
        const currentHash=hashPdfBytes_(file.getBlob().getBytes());
        if(currentHash!==rec.afterHash)
          throw new Error('PDF changed since generation; left unchanged.');
        if(rec.created) {
          undoCreatedTracker_(rec,file,ss);
        } else {
          const backup=DriveApp.getFileById(rec.backupId);
          updateDrivePdf_(rec.fileId,backup.getBlob());
          if(rec.previousFileName) file.setName(rec.previousFileName);
        }
        const sh=ss.getSheetByName(rec.tab);
        if(sh && sh.getRange(rec.row,1).getDisplayValue().trim()===rec.student) {
          setTrackerIndicator_(sh,rec.row,'UNDONE',
            'Restored previous version of '+rec.fileName+'. Previous status: '+rec.statusBefore);
        }
        props.deleteProperty(key);
        restored++;
      } catch(e) {skipped++;errors.push(rec.fileName+': '+e.message);}
    }
    if(skipped===0) props.deleteProperty(trackerRunKey_());
    return {
      restored,skipped,remaining:skipped>0,
      message:restored+' PDF(s) restored.'+
        (skipped?' '+skipped+' skipped for safety. '+errors.slice(0,5).join(' | '):'')
    };
  } finally {lock.releaseLock();}
}

function updateDrivePdf_(fileId,blob) {
  const endpoint='https://www.googleapis.com/upload/drive/v3/files/'+encodeURIComponent(fileId)+'?uploadType=media';
  const res=UrlFetchApp.fetch(endpoint,{
    method:'patch',headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},
    contentType:'application/pdf',payload:blob.getBytes(),muteHttpExceptions:true
  });
  if(res.getResponseCode()<200||res.getResponseCode()>=300) {
    throw new Error('Drive update rejected ('+res.getResponseCode()+'): '+res.getContentText());
  }
}
